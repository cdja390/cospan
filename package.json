{
  "name": "cospan",
  "version": "0.1.0",
  "description": "Orchestrate every model in its native harness — unified async delegation across Antigravity, Codex, Claude Code, and DeepSeek Harness.",
  "type": "module",
  "bin": {
    "cospan": "./bin/cospan.mjs"
  },
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keli-wen/cospan.git"
  },
  "homepage": "https://github.com/keli-wen/cospan",
  "bugs": "https://github.com/keli-wen/cospan/issues",
  "files": [
    "assets/",
    "bin/",
    "lib/",
    "mcp/",
    "skills/",
    "dsh/",
    ".antigravity-plugin/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    ".mcp.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh/cordis.patch.yml",
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "listedByDefault": true
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
